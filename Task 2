  board = Array(9).fill(" ");
  over = false; busy = false;
  nodesEl.textContent = "";
  if (humanFirst) { statusEl.textContent = "Your turn (X)"; render(); }
  else askAI();
}

document.getElementById("goFirst").onclick = e => setFirst(true);
document.getElementById("aiFirst").onclick = e => setFirst(false);
function setFirst(h) {
  humanFirst = h;
  document.getElementById("goFirst").classList.toggle("active", h);
  document.getElementById("aiFirst").classList.toggle("active", !h);
  newGame();
}
