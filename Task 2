const score = { w: 0, d: 0, l: 0 };

async function askAI() {
  busy = true; statusEl.textContent = "AI is thinking...";
  render();
  const res = await fetch("/api/move", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ board })
  });
  const data = await res.json();
  board = data.board;
  if (data.nodes) nodesEl.textContent = "AI searched " + data.nodes + " positions";
  busy = false;
  finish(data);
}

function finish(data) {
  if (data.status === "playing") {
    statusEl.textContent = "Your turn (X)";
    over = false;
  } else {
    over = true;
    if (data.status === "X") { statusEl.textContent = "You win!"; score.w++; }
    else if (data.status === "O") { statusEl.textContent = "The AI wins"; score.l++; }
    else { statusEl.textContent = "Draw"; score.d++; }
    document.getElementById("sw").textContent = score.w;
    document.getElementById("sd").textContent = score.d;
    document.getElementById("sl").textContent = score.l;
  }
  render(data.line);
}

