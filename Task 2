  boardEl.innerHTML = "";
  board.forEach((v, i) => {
    const b = document.createElement("button");
    b.className = "cell" + (v.trim() ? " " + v : "") + (line && line.includes(i) ? " win" : "");
    b.textContent = v.trim();
    b.disabled = busy || over || v !== " ";
    b.onclick = () => {
      board[i] = "X";
      askAI();
    };
    boardEl.appendChild(b);
  });
}

