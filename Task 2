"""
Unbeatable Tic-Tac-Toe in your browser.
Python backend (Minimax + Alpha-Beta Pruning), served on localhost. No installs needed.

Run:   python tictactoe_web.py
Open:  http://localhost:8000      (it also tries to open automatically)
Stop:  Ctrl+C
Other port: python tictactoe_web.py 9000
"""
import json
import sys
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

AI, HUMAN, EMPTY = "O", "X", " "
WIN_LINES = [(0, 1, 2), (3, 4, 5), (6, 7, 8),
             (0, 3, 6), (1, 4, 7), (2, 5, 8),
             (0, 4, 8), (2, 4, 6)]


# ---------------------------------------------------------------- AI logic
def check(b):
    """Return (winner_or_None, winning_line_or_None)."""
    for line in WIN_LINES:
        a, c, d = line
        if b[a] != EMPTY and b[a] == b[c] == b[d]:
            return b[a], list(line)
    return None, None


def moves(b):
    return [i for i, v in enumerate(b) if v == EMPTY]


def minimax(b, is_ai_turn, alpha, beta, depth, counter):
    counter[0] += 1
    w, _ = check(b)
    if w == AI:
        return 10 - depth
    if w == HUMAN:
        return depth - 10
    if EMPTY not in b:
        return 0

    if is_ai_turn:
        best = -float("inf")
        for m in moves(b):
            b[m] = AI
            best = max(best, minimax(b, False, alpha, beta, depth + 1, counter))
            b[m] = EMPTY
            alpha = max(alpha, best)
            if beta <= alpha:
                break
        return best
    best = float("inf")
    for m in moves(b):
        b[m] = HUMAN
        best = min(best, minimax(b, True, alpha, beta, depth + 1, counter))
        b[m] = EMPTY
        beta = min(beta, best)
        if beta <= alpha:
            break
    return best


def best_move(b):
    counter = [0]
    best_score, choice = -float("inf"), None
    for m in moves(b):
        b[m] = AI
        score = minimax(b, False, -float("inf"), float("inf"), 1, counter)
        b[m] = EMPTY
        if score > best_score:
            best_score, choice = score, m
    return choice, counter[0]


def status_of(b):
    w, line = check(b)
    if w:
        return w, line
    if EMPTY not in b:
        return "draw", None
    return "playing", None


def handle_move(board):
    """Take the board from the browser, let the AI reply, return new state."""
    if (not isinstance(board, list) or len(board) != 9
            or any(c not in (HUMAN, AI, EMPTY) for c in board)):
        raise ValueError("bad board")
    nodes = 0
    status, line = status_of(board)
    if status == "playing":
        m, nodes = best_move(board)
        board[m] = AI
        status, line = status_of(board)
    return {"board": board, "status": status, "line": line, "nodes": nodes}


# -------------------------------------------------------------- Web server
PAGE = r"""<!DOCTYPE html>
