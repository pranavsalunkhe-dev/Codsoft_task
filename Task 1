
"""
Web version of the rule-based chatbot, 100% Python (no installs needed).

Put this file in the SAME folder as chatbot.py, then run:
    python web_app.py
Your browser will open at http://localhost:8000
Press Ctrl+C in the terminal to stop the server.
"""

import json
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer

from chatbot import respond  # the brain: normalize + if-else + regex rules

HOST, PORT = "127.0.0.1", 8000

PAGE = """<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rule-Based Chatbot</title>
<style>
:root{--bg:#eef1f6;--surface:#fff;--ink:#14213d;--muted:#5d6881;--line:#d9dfeb;--accent:#3b4cca;--accent-ink:#fff;--bot:#e6eaf4;--tag:#fff3cf;--tag-ink:#6b4a00}
@media (prefers-color-scheme:dark){:root{--bg:#0f1219;--surface:#171b26;--ink:#e8ecf7;--muted:#9aa5bf;--line:#2a3144;--accent:#7f8cff;--accent-ink:#0f1219;--bot:#212737;--tag:#3a2f10;--tag-ink:#f3d58a}}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;display:flex;justify-content:center}
.app{width:100%;max-width:720px;height:100%;display:flex;flex-direction:column;padding:0 14px}
header{padding:16px 2px 10px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
h1{font-size:1.25rem;margin:0}
.sub{margin:2px 0 0;color:var(--muted);font-size:.875rem}
.tog{font-size:.875rem;color:var(--muted);display:flex;gap:6px;align-items:center;cursor:pointer}
#log{flex:1;overflow-y:auto;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px}
.msg{max-width:84%;display:flex;flex-direction:column;gap:4px}
.msg.user{align-self:flex-end;align-items:flex-end}
.bubble{padding:9px 13px;border-radius:14px;white-space:pre-wrap;overflow-wrap:anywhere}
.bot .bubble{background:var(--bot);border-bottom-left-radius:4px}
.user .bubble{background:var(--accent);color:var(--accent-ink);border-bottom-right-radius:4px}
.trace{font:.75rem/1.4 ui-monospace,Consolas,monospace;background:var(--tag);color:var(--tag-ink);padding:3px 8px;border-radius:6px}
